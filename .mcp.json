{
  "mcpServers": {
    "graphiti": {
      "command": "uvx",
      "args": [
        "--from",
        "graphiti-mcp[anthropic]",
        "graphiti-mcp",
        "--llm-provider",
        "anthropic",
        "--model",
        "claude-opus-5"
      ],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}",
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}"
      }
    }
  }
}
